@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center my-5">
    <h1 class="display-4 fw-bold text-primary">🏥 Bienvenid@@ al Sistema de Citas Médicas</h1>
    <p class="lead text-muted">Gestión integral de médicos, pacientes y agenda de citas en un solo lugar.</p>
</div>

<div class="row mt-5 g-4 text-center justify-content-center">
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="fs-1 mb-2">👨‍⚕️</div>
                <h5 class="card-title">Médicos</h5>
                <p class="card-text text-muted small">Administra el personal médico y especialidades.</p>
                <a asp-controller="Medicos" asp-action="Index" class="btn btn-outline-primary btn-sm">Ir a Médicos</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="fs-1 mb-2">🧑‍🤝‍🧑</div>
                <h5 class="card-title">Pacientes</h5>
                <p class="card-text text-muted small">Registro e historial de pacientes.</p>
                <a asp-controller="Pacientes" asp-action="Index" class="btn btn-outline-primary btn-sm">Ir a Pacientes</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="fs-1 mb-2">📅</div>
                <h5 class="card-title">Gestión de Citas</h5>
                <p class="card-text text-muted small">Agenda, cancelaciones e historial en una sola vista.</p>
                <a asp-controller="CitasAgregadas" asp-action="Index" class="btn btn-outline-primary btn-sm">Ir a Citas</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="fs-1 mb-2">📊</div>
                <h5 class="card-title">Estadísticas</h5>
                <p class="card-text text-muted small">Reportes de demanda, pacientes recurrentes y cancelaciones.</p>
                <a asp-controller="Estadisticas" asp-action="Index" class="btn btn-outline-primary btn-sm">Ver Estadísticas</a>
            </div>
        </div>
    </div>
</div>