@model IEnumerable<CitasMedicas.Models.Cita>

@{
    ViewData["Title"] = "Citas Activas";
}

<h2 class="mb-4">📅 Gestión de Citas Activas</h2>

<ul class="nav nav-tabs" id="citasTab" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#ver-activas" type="button">🟢 Citas Activas</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#agregar-cita" type="button">➕ Agendar Cita</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#actualizar-cita" type="button">✏️ Reprogramar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#cancelar-cita" type="button">🚫 Cancelar Cita</button>
    </li>
</ul>

<div class="tab-content border border-top-0 p-4 bg-white rounded-bottom">

    <!-- 1. LISTADO DE ACTIVAS -->
    <div class="tab-pane fade show active" id="ver-activas">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Estado</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Fecha y Hora</th>
                    <th>Motivo</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var cita in Model)
                    {
                        <tr>
                            <td>@cita.Id</td>
                            <td><span class="badge bg-success">@cita.Estado</span></td>
                            <td>@cita.Paciente?.NombreCompleto</td>
                            <td>@cita.Medico?.NombreCompleto <small class="text-muted">(@cita.Medico?.Especialidad)</small></td>
                            <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@cita.Motivo</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No hay citas activas registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 2. AGENDAR -->
    <div class="tab-pane fade" id="agregar-cita">
        <h4>Agendar Nueva Cita</h4>
        <form asp-controller="Citas" asp-action="Create" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">Paciente:</label>
                <select name="PacienteId" class="form-select" asp-items="ViewBag.Pacientes" required>
                    <option value="">-- Seleccione un Paciente --</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Médico:</label>
                <select name="MedicoId" class="form-select" asp-items="ViewBag.Medicos" required>
                    <option value="">-- Seleccione un Médico --</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Fecha y Hora:</label>
                <input type="datetime-local" name="FechaHora" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Motivo de Consulta:</label>
                <input type="text" name="Motivo" class="form-control" placeholder="Ej: Chequeo general" required />
            </div>
            <button type="submit" class="btn btn-primary">➕ Agendar Cita</button>
        </form>
    </div>

    <!-- 3. ACTUALIZAR -->
    <div class="tab-pane fade" id="actualizar-cita">
        <h4>Reprogramar Cita Activa</h4>
        <form asp-controller="Citas" asp-action="Edit" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID de la Cita:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Nueva Fecha y Hora:</label>
                <input type="datetime-local" name="FechaHora" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Nuevo Motivo:</label>
                <input type="text" name="Motivo" class="form-control" placeholder="Dejar en blanco para mantener el actual" />
            </div>
            <button type="submit" class="btn btn-warning">✏️ Actualizar Cita</button>
        </form>
    </div>

    <!-- 4. CANCELAR -->
    <div class="tab-pane fade" id="cancelar-cita">
        <h4>Cancelar Cita Activa</h4>
        <form asp-controller="Citas" asp-action="Cancelar" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID de la Cita a Cancelar:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID de la cita" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Motivo de Cancelación:</label>
                <input type="text" name="motivoCancelacion" class="form-control" placeholder="Ej: Motivos personales" required />
            </div>
            <button type="submit" class="btn btn-danger" onclick="return confirm('¿Confirma que desea cancelar esta cita?');">🚫 Cancelar Cita</button>
        </form>
    </div>

</div>