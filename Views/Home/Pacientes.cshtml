@model IEnumerable<CitasMedicas.Models.Paciente>

@{
    ViewData["Title"] = "Gestión de Pacientes";
}

<h2 class="mb-4">🧑‍⚕️ Gestión de Pacientes</h2>

<ul class="nav nav-tabs" id="pacientesTab" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#ver-pacientes" type="button">🔍 Ver / Listar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#agregar-paciente" type="button">➕ Agregar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#actualizar-paciente" type="button">✏️ Actualizar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#eliminar-paciente" type="button">🗑️ Eliminar</button>
    </li>
</ul>

<div class="tab-content border border-top-0 p-4 bg-white rounded-bottom">

    <!-- 1. LISTAR PACIENTES -->
    <div class="tab-pane fade show active" id="ver-pacientes">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombres</th>
                    <th>Apellidos</th>
                    <th>CI</th>
                    <th>Teléfono</th>
                    <th>Dirección</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.Nombres</td>
                            <td>@p.Apellidos</td>
                            <td>@p.CI</td>
                            <td>@p.Telefono</td>
                            <td>@p.Direccion</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No hay pacientes registrados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 2. AGREGAR PACIENTE -->
    <div class="tab-pane fade" id="agregar-paciente">
        <h4>Registrar Nuevo Paciente</h4>
        <form asp-controller="Pacientes" asp-action="Create" method="post" class="mt-3">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombres:</label>
                    <input type="text" name="Nombres" class="form-control" placeholder="Ej: María Fernanda" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Apellidos:</label>
                    <input type="text" name="Apellidos" class="form-control" placeholder="Ej: López" required />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">CI:</label>
                    <input type="text" name="CI" class="form-control" placeholder="Ej: 8451236" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Teléfono:</label>
                    <input type="text" name="Telefono" class="form-control" placeholder="Ej: 71548921" required />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Dirección:</label>
                    <input type="text" name="Direccion" class="form-control" placeholder="Ej: Av. Arce #2140" required />
                </div>
            </div>
            <button type="submit" class="btn btn-primary">➕ Guardar Paciente</button>
        </form>
    </div>

    <!-- 3. ACTUALIZAR PACIENTE -->
    <div class="tab-pane fade" id="actualizar-paciente">
        <h4>Actualizar Datos del Paciente</h4>
        <form asp-controller="Pacientes" asp-action="Edit" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID del Paciente:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID" required />
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nuevos Nombres:</label>
                    <input type="text" name="Nombres" class="form-control" placeholder="Dejar en blanco para mantener" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Nuevos Apellidos:</label>
                    <input type="text" name="Apellidos" class="form-control" placeholder="Dejar en blanco para mantener" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Nuevo CI:</label>
                    <input type="text" name="CI" class="form-control" placeholder="Dejar en blanco para mantener" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Nuevo Teléfono:</label>
                    <input type="text" name="Telefono" class="form-control" placeholder="Dejar en blanco para mantener" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Nueva Dirección:</label>
                    <input type="text" name="Direccion" class="form-control" placeholder="Dejar en blanco para mantener" />
                </div>
            </div>
            <button type="submit" class="btn btn-warning">✏️ Actualizar Paciente</button>
        </form>
    </div>

    <!-- 4. ELIMINAR PACIENTE -->
    <div class="tab-pane fade" id="eliminar-paciente">
        <h4>Eliminar Paciente</h4>
        <form asp-controller="Pacientes" asp-action="Delete" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID del Paciente a Eliminar:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID" required />
            </div>
            <button type="submit" class="btn btn-danger" onclick="return confirm('¿Está seguro de eliminar este paciente?');">🗑️ Eliminar Paciente</button>
        </form>
    </div>

</div>