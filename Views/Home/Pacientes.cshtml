@{
    ViewData["Title"] = "Gestión de Pacientes";
}

<h2 class="mb-4">🧑‍🤝‍🧑 Gestión de Pacientes</h2>

<ul class="nav nav-tabs" id="pacientesTab" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" id="ver-p-tab" data-bs-toggle="tab" data-bs-target="#ver-p" type="button">🔍 Ver / Listar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="agregar-p-tab" data-bs-toggle="tab" data-bs-target="#agregar-p" type="button">➕ Agregar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="actualizar-p-tab" data-bs-toggle="tab" data-bs-target="#actualizar-p" type="button">✏️ Actualizar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="borrar-p-tab" data-bs-toggle="tab" data-bs-target="#borrar-p" type="button">🗑️ Borrar</button>
    </li>
</ul>

<div class="tab-content border border-top-0 p-4 bg-white rounded-bottom" id="pacientesTabContent">
    <div class="tab-pane fade show active" id="ver-p">
        <h4>Lista de Pacientes</h4>
        <p>Contenido para visualizar pacientes.</p>
    </div>
    <div class="tab-pane fade" id="agregar-p">
        <h4>Agregar Paciente</h4>
        <p>Formulario para registrar paciente.</p>
    </div>
    <div class="tab-pane fade" id="actualizar-p">
        <h4>Actualizar Paciente</h4>
        <p>Formulario para modificar paciente.</p>
    </div>
    <div class="tab-pane fade" id="borrar-p">
        <h4>Borrar Paciente</h4>
        <p>Formulario para eliminar paciente.</p>
    </div>
</div>