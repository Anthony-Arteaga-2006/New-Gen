@model IEnumerable<CitasMedicas.Models.Paciente>

@{
    ViewData["Title"] = "Gestión de Pacientes";
}

<h2 class="mb-4">🧑‍🤝‍🧑 Gestión de Pacientes</h2>

<ul class="nav nav-tabs" id="pacientesTab" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" id="ver-p-tab" data-bs-toggle="tab" data-bs-target="#ver-p" type="button">🔍 Ver / Listar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="agregar-p-tab" data-bs-toggle="tab" data-bs-target="#agregar-p" type="button">➕ Agregar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="actualizar-p-tab" data-bs-toggle="tab" data-bs-target="#actualizar-p" type="button">✏️ Actualizar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="borrar-p-tab" data-bs-toggle="tab" data-bs-target="#borrar-p" type="button">🗑️ Borrar</button>
    </li>
</ul>

<div class="tab-content border border-top-0 p-4 bg-white rounded-bottom" id="pacientesTabContent">
    
    <!-- 1. VER / LISTAR PACIENTES -->
    <div class="tab-pane fade show active" id="ver-p">
        <h4>Lista de Pacientes</h4>
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Documento</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var paciente in Model)
                    {
                        <tr>
                            <td>@paciente.Id</td>
                            <td>@paciente.Nombre</td>
                            <td>@paciente.Documento</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">No hay pacientes registrados aún.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 2. FORMULARIO AGREGAR -->
    <div class="tab-pane fade" id="agregar-p">
        <h4>Agregar Paciente</h4>
        <form asp-action="AgregarPaciente" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">Nombre Completo:</label>
                <input type="text" name="nombre" class="form-control" placeholder="Ej: María López" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Documento / Cédula:</label>
                <input type="text" name="documento" class="form-control" placeholder="Ej: 12345678" required />
            </div>
            <button type="submit" class="btn btn-primary">➕ Registrar Paciente</button>
        </form>
    </div>

    <!-- 3. FORMULARIO ACTUALIZAR -->
    <div class="tab-pane fade" id="actualizar-p">
        <h4>Actualizar Paciente</h4>
        <form asp-action="ActualizarPaciente" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID del Paciente a Modificar:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Nuevo Nombre:</label>
                <input type="text" name="nombre" class="form-control" placeholder="Dejar en blanco para mantener el actual" />
            </div>
            <div class="mb-3">
                <label class="form-label">Nuevo Documento:</label>
                <input type="text" name="documento" class="form-control" placeholder="Dejar en blanco para mantener el actual" />
            </div>
            <button type="submit" class="btn btn-warning">✏️ Actualizar Datos</button>
        </form>
    </div>

    <!-- 4. FORMULARIO BORRAR -->
    <div class="tab-pane fade" id="borrar-p">
        <h4>Borrar Paciente</h4>
        <form asp-action="BorrarPaciente" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID del Paciente a Eliminar:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID del paciente" required />
            </div>
            <button type="submit" class="btn btn-danger" onclick="return confirm('¿Confirma que desea eliminar este paciente?');">🗑️ Eliminar Paciente</button>
        </form>
    </div>

</div>