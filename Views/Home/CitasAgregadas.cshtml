@model IEnumerable<CitasMedicas.Models.CitaAgregada>

@{
    ViewData["Title"] = "Gestión de Citas";
    var citasCanceladas = ViewBag.CitasCanceladas as IEnumerable<CitasMedicas.Models.CitaCancelada> ?? Enumerable.Empty<CitasMedicas.Models.CitaCancelada>();
    var historial = ViewBag.Historial as IEnumerable<CitasMedicas.Models.Historial> ?? Enumerable.Empty<CitasMedicas.Models.Historial>();
}

<h2 class="mb-4">📅 Gestión de Citas</h2>

<ul class="nav nav-tabs" id="citasTab" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" id="ver-tab" data-bs-toggle="tab" data-bs-target="#ver-citas" type="button">🔍 Ver / Listar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="agregar-tab" data-bs-toggle="tab" data-bs-target="#agregar-cita" type="button">➕ Agregar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="actualizar-tab" data-bs-toggle="tab" data-bs-target="#actualizar-cita" type="button">✏️ Actualizar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="cancelar-tab" data-bs-toggle="tab" data-bs-target="#cancelar-cita" type="button">🚫 Cancelar / Borrar</button>
    </li>
</ul>

<div class="tab-content border border-top-0 p-4 bg-white rounded-bottom" id="citasTabContent">

    <!-- 1. LISTA ÚNICA DE TODAS LAS CITAS (ACTIVAS + CANCELADAS + HISTORIAL) -->
    <div class="tab-pane fade show active" id="ver-citas">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="mb-0">Listado General de Citas</h4>
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-dark btn-sm active" onclick="filtrarCitas('todas', this)">Todas</button>
                <button type="button" class="btn btn-outline-success btn-sm" onclick="filtrarCitas('activa', this)">Activas</button>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="filtrarCitas('cancelada', this)">Canceladas</button>
            </div>
        </div>

        <table class="table table-striped table-hover" id="tablaUnificada">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Estado</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Fecha y Hora</th>
                    <th>Motivo / Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var cita in Model)
                    {
                        <tr class="fila-cita" data-estado="activa">
                            <td>@cita.Id</td>
                            <td><span class="badge bg-success">Activa</span></td>
                            <td>@cita.Paciente?.Nombre</td>
                            <td>@cita.Medico?.Nombre</td>
                            <td>@cita.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@cita.Motivo</td>
                        </tr>
                    }
                }
                @foreach (var canc in citasCanceladas)
                {
                    <tr class="fila-cita" data-estado="cancelada">
                        <td>@canc.Id</td>
                        <td><span class="badge bg-danger">Cancelada</span></td>
                        <td>@canc.Paciente?.Nombre</td>
                        <td>@canc.Medico?.Nombre</td>
                        <td>@canc.FechaHoraOriginal.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@canc.MotivoCancelacion <small class="text-muted">(Cancelada el @canc.FechaCancelacion.ToString("dd/MM/yyyy HH:mm"))</small></td>
                    </tr>
                }
                @if ((Model == null || !Model.Any()) && !citasCanceladas.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No hay citas registradas aún.</td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- HISTORIAL DE MOVIMIENTOS EN LA MISMA PANTALLA -->
        <h5 class="mt-5 mb-3">📜 Historial de Movimientos</h5>
        <table class="table table-sm table-bordered table-hover">
            <thead class="table-secondary">
                <tr>
                    <th>Cita ID</th>
                    <th>Paciente</th>
                    <th>Acción</th>
                    <th>Detalle</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody>
                @if (historial.Any())
                {
                    @foreach (var h in historial)
                    {
                        <tr>
                            <td>#@h.CitaId</td>
                            <td>@h.Cita?.Paciente?.Nombre</td>
                            <td><span class="badge bg-info text-dark">@h.Accion</span></td>
                            <td>@h.Detalle</td>
                            <td>@h.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Sin movimientos registrados aún.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 2. AGREGAR CITA -->
    <div class="tab-pane fade" id="agregar-cita">
        <h4>Agendar Nueva Cita</h4>
        <form asp-controller="CitasAgregadas" asp-action="Create" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">Paciente:</label>
                <select name="PacienteId" class="form-select" asp-items="ViewBag.Pacientes" required>
                    <option value="">-- Seleccione un Paciente --</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Médico:</label>
                <select name="MedicoId" class="form-select" asp-items="ViewBag.Medicos" required>
                    <option value="">-- Seleccione un Médico --</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label">Fecha y Hora:</label>
                <input type="datetime-local" name="FechaHora" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Motivo de Consulta:</label>
                <input type="text" name="Motivo" class="form-control" placeholder="Ej: Chequeo general" required />
            </div>
            <button type="submit" class="btn btn-primary">➕ Agendar Cita</button>
        </form>
    </div>

    <!-- 3. ACTUALIZAR CITA -->
    <div class="tab-pane fade" id="actualizar-cita">
        <h4>Modificar Cita Activa</h4>
        <form asp-controller="CitasAgregadas" asp-action="Edit" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID de la Cita:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Nueva Fecha y Hora:</label>
                <input type="datetime-local" name="FechaHora" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Nuevo Motivo:</label>
                <input type="text" name="Motivo" class="form-control" placeholder="Dejar en blanco para mantener el actual" />
            </div>
            <button type="submit" class="btn btn-warning">✏️ Actualizar Cita</button>
        </form>
    </div>

    <!-- 4. CANCELAR CITA -->
    <div class="tab-pane fade" id="cancelar-cita">
        <h4>Cancelar Cita</h4>
        <form asp-controller="CitasAgregadas" asp-action="Delete" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID de la Cita a Cancelar:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID de la cita" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Motivo de Cancelación:</label>
                <input type="text" name="motivoCancelacion" class="form-control" placeholder="Ej: Motivos personales" required />
            </div>
            <button type="submit" class="btn btn-danger" onclick="return confirm('¿Confirma que desea cancelar esta cita?');">🚫 Cancelar Cita</button>
        </form>
    </div>

</div>

<script>
    function filtrarCitas(estado, boton) {
        document.querySelectorAll('#ver-citas .btn-group .btn').forEach(b => b.classList.remove('active'));
        boton.classList.add('active');

        document.querySelectorAll('.fila-cita').forEach(fila => {
            if (estado === 'todas' || fila.dataset.estado === estado) {
                fila.style.display = '';
            } else {
                fila.style.display = 'none';
            }
        });
    }
</script>