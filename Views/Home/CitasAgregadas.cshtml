@{
    ViewData["Title"] = "Citas Agregadas";
}

<h2 class="mb-4">📅 Control de Citas Agregadas</h2>

<ul class="nav nav-tabs" id="citasAgregadasTab" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" id="ver-ca-tab" data-bs-toggle="tab" data-bs-target="#ver-ca" type="button">🔍 Ver / Listar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="agregar-ca-tab" data-bs-toggle="tab" data-bs-target="#agregar-ca" type="button">➕ Agregar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="actualizar-ca-tab" data-bs-toggle="tab" data-bs-target="#actualizar-ca" type="button">✏️ Actualizar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="borrar-ca-tab" data-bs-toggle="tab" data-bs-target="#borrar-ca" type="button">🗑️ Borrar</button>
    </li>
</ul>

<div class="tab-content border border-top-0 p-4 bg-white rounded-bottom" id="citasAgregadasTabContent">
    <div class="tab-pane fade show active" id="ver-ca">
        <h4>Citas Activas</h4>
        <p>Contenido para visualizar citas agendadas.</p>
    </div>
    <div class="tab-pane fade" id="agregar-ca">
        <h4>Agendar Nueva Cita</h4>
        <p>Formulario para agendar cita.</p>
    </div>
    <div class="tab-pane fade" id="actualizar-ca">
        <h4>Modificar Cita</h4>
        <p>Formulario para cambiar fecha u horario.</p>
    </div>
    <div class="tab-pane fade" id="borrar-ca">
        <h4>Eliminar Cita</h4>
        <p>Formulario para dar de baja una cita.</p>
    </div>
</div>