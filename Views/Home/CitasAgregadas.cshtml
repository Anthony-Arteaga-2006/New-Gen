@model IEnumerable<CitasMedicas.Models.Cita>

@{
    ViewData["Title"] = "Citas Agregadas";
}

<h2 class="mb-4">📅 Control de Citas Agregadas</h2>

<ul class="nav nav-tabs" id="citasAgregadasTab" role="tablist">
    <li class="nav-item">
        <button class="nav-link active" id="ver-ca-tab" data-bs-toggle="tab" data-bs-target="#ver-ca" type="button">🔍 Ver / Listar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="agregar-ca-tab" data-bs-toggle="tab" data-bs-target="#agregar-ca" type="button">➕ Agregar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="actualizar-ca-tab" data-bs-toggle="tab" data-bs-target="#actualizar-ca" type="button">✏️ Actualizar</button>
    </li>
    <li class="nav-item">
        <button class="nav-link" id="borrar-ca-tab" data-bs-toggle="tab" data-bs-target="#borrar-ca" type="button">🗑️ Borrar</button>
    </li>
</ul>

<div class="tab-content border border-top-0 p-4 bg-white rounded-bottom" id="citasAgregadasTabContent">
    
    <!-- 1. VER / LISTAR CITAS -->
    <div class="tab-pane fade show active" id="ver-ca">
        <h4>Citas Activas</h4>
        <table class="table table-striped table-hover mt-3">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Paciente</th>
                    <th>Médico</th>
                    <th>Fecha y Hora</th>
                    <th>Motivo</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var cita in Model)
                    {
                        <tr>
                            <td>@cita.Id</td>
                            <td>@cita.PacienteNombre</td>
                            <td>@cita.MedicoNombre</td>
                            <td>@cita.Fecha.ToString("g")</td>
                            <td>@cita.Motivo</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No hay citas activas registradas aún.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 2. FORMULARIO AGREGAR -->
    <div class="tab-pane fade" id="agregar-ca">
        <h4>Agendar Nueva Cita</h4>
        <form asp-action="AgregarCita" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">Nombre del Paciente:</label>
                <input type="text" name="pacienteNombre" class="form-control" placeholder="Ej: María López" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Nombre del Médico:</label>
                <input type="text" name="medicoNombre" class="form-control" placeholder="Ej: Dr. Juan Pérez" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Fecha y Hora:</label>
                <input type="datetime-local" name="fecha" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Motivo de Consulta:</label>
                <input type="text" name="motivo" class="form-control" placeholder="Ej: Chequeo general" required />
            </div>
            <button type="submit" class="btn btn-primary">➕ Agendar Cita</button>
        </form>
    </div>

    <!-- 3. FORMULARIO ACTUALIZAR -->
    <div class="tab-pane fade" id="actualizar-ca">
        <h4>Modificar Cita</h4>
        <form asp-action="ActualizarCita" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID de la Citas a Modificar:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Nueva Fecha y Hora:</label>
                <input type="datetime-local" name="fecha" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Nuevo Motivo:</label>
                <input type="text" name="motivo" class="form-control" placeholder="Dejar en blanco para mantener el actual" />
            </div>
            <button type="submit" class="btn btn-warning">✏️ Actualizar Cita</button>
        </form>
    </div>

    <!-- 4. FORMULARIO BORRAR -->
    <div class="tab-pane fade" id="borrar-ca">
        <h4>Eliminar Cita</h4>
        <form asp-action="BorrarCita" method="post" class="mt-3">
            <div class="mb-3">
                <label class="form-label">ID de la Cita a Eliminar:</label>
                <input type="number" name="id" class="form-control" placeholder="Ingrese el ID de la cita" required />
            </div>
            <button type="submit" class="btn btn-danger" onclick="return confirm('¿Confirma que desea eliminar esta cita?');">🗑️ Eliminar Cita</button>
        </form>
    </div>

</div>